# --- OS ---
.DS_Store

# --- Private (local-only provenance / untracked material) ---
/private/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environments ---
.venv/
venv/
env/
.env
.python-version

# --- Notebooks ---
.ipynb_checkpoints/

# --- Experiment tracking / run artifacts ---
wandb/
mlruns/
runs/
outputs/
logs/

# --- Model weights & adapters (never commit) ---
checkpoints/
adapters/
*.safetensors
*.bin
*.pt
*.gguf

# --- Data ---
# Raw, private, and cached data are never committed.
# Manifests (data/manifests/) and sanitized examples (data/public_sanitized_examples/) ARE tracked.
data/raw/
data/private/
data/cache/
data/prepared/
# unanchored: keep any prepared/ dir private even under a non-default --data-dir
prepared/
# Exception: eval-harness test fixtures are synthetic, non-sensitive placeholders (safe to commit).
!tests/fixtures/**/prepared/
!tests/fixtures/**/prepared/**
# unanchored: keep any generation/judgment cache (raw prompts + responses) private even under a
# non-default --data-dir or --cache-dir
cache/
*.arrow

# --- Secrets ---
*.key
.hf_token
